# Copy this file to backend/.env and fill in the values.
# backend/.env is git-ignored: real secrets must never be committed.

# Password for the local Postgres containers in docker-compose.yml.
POSTGRES_PASSWORD=

# Database URLs for SQLAlchemy with the psycopg 3 driver. Put the password from above in both.
# The test database is wiped on every test run, so it must never be the same as DATABASE_URL.
# For Neon: copy its connection string and change "postgresql://" at the start to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5433/course_delivery
TEST_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5434/course_delivery_test

# Secret that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a login lasts, in minutes (480 = 8 hours).
JWT_EXPIRE_MINUTES=480

# Comma-separated browser origins allowed to call the API: the Vite dev server now, the Vercel URL later.
CORS_ORIGINS=http://localhost:5173

# Password given to every demo account by `python -m app.seed`.
SEED_PASSWORD=
